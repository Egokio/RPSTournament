<Window x:Class="RPSTournament.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RPSTournament"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid x:Name="RPS">
        <TextBox x:Name="NameBox" HorizontalAlignment="Left" Margin="111,123,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" FontSize="24" TextChanged="NameBox_TextChanged"/>
        <Label Content="Choose your name:" HorizontalAlignment="Left" Margin="17,65,0,0" VerticalAlignment="Top" FontSize="24"/>
        <ComboBox x:Name="PlayerMove" HorizontalAlignment="Left" Margin="111,190,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="ComboBox_SelectionChanged"/>
        <Button x:Name="PlayRound" Content="Play" HorizontalAlignment="Left" Margin="548,123,0,0" VerticalAlignment="Top" Height="83" Width="170" Click="PlayRound_Click"/>
        <DataGrid d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,242,285,56" SelectionChanged="DataGrid_SelectionChanged"/>
        <TextBlock x:Name="Score" HorizontalAlignment="Left" Margin="662,297,0,0" TextWrapping="Wrap" Text="Score:" VerticalAlignment="Top" Height="40" Width="75" FontSize="16"/>
        <TextBlock x:Name="Status" HorizontalAlignment="Left" Margin="678,342,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="38" Width="53" FontSize="16"><Run Text="Status"/><LineBreak/><Run/><LineBreak/><Run/></TextBlock>
        <Button x:Name="NewTournament" Content="Start New Tournament" HorizontalAlignment="Left" Margin="366,96,0,0" VerticalAlignment="Top" Height="64" Width="129" Click="NewTournament_Click"/>

    </Grid>
</Window>
