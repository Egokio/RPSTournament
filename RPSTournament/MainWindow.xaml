<Window x:Class="RPSTournament.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rock Paper Scissors Tournament"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Rock Paper Scissors Tournament"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Player name -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <TextBlock Text="Player name:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <TextBox x:Name="NameBox"
                     Width="200"
                     Height="30"
                     TextChanged="NameBox_TextChanged"/>
        </StackPanel>

        <!-- Move selection -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <TextBlock Text="Choose your move:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <ComboBox x:Name="MoveBox"
                      Width="150"
                      Height="30"
                      SelectionChanged="ComboBox_SelectionChanged">

                <ComboBoxItem Content="Rock"/>
                <ComboBoxItem Content="Paper"/>
                <ComboBoxItem Content="Scissors"/>

            </ComboBox>

            <Button Content="Play Round"
                    Width="120"
                    Height="30"
                    Margin="15,0,0,0"
                    Click="PlayRound_Click"/>

        </StackPanel>

        <!-- Round history -->
        <DataGrid Grid.Row="2"
                  x:Name="RoundsGrid"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  Margin="0,45,10,196"
                  SelectionChanged="DataGrid_SelectionChanged" Grid.RowSpan="2"/>

        <!-- Bottom information -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <TextBlock x:Name="ScoreText"
                       Text="Score: 0 - 0"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,30,0"/>

            <Button Content="New Tournament"
                    Width="140"
                    Height="35"
                    Click="NewTournament_Click"/>

        </StackPanel>

    </Grid>
</Window>
    